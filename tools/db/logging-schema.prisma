generator client {
  provider      = "prisma-client-js"
  output        = env("LOGGING_CLIENT_OUTPUT")
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("LOGGING_DATABASE_URL")
}

model Log {
  id      String   @id @unique @default(uuid())
  level   String
  date    DateTime
  appId   String
  message String
}
