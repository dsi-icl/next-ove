{
  "name": "ove-mirror",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-mirror",
  "projectType": "application",
  "targets": {
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["tsc -p apps/ove-mirror/tsconfig.app.json --noEmit --incremental"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ove-mirror/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "options": {
        "parallel": false,
        "cwd": "{workspaceRoot}/",
        "commands": [
          "rm -rf dist/{projectRoot}",
          "esbuild {projectRoot}/src/content.ts {projectRoot}/src/seed-hook.ts --bundle --platform=browser --target=chrome109 --format=iife --outdir=dist/{projectRoot} --tsconfig={projectRoot}/tsconfig.json --minify",
          "cp \"{projectRoot}/src/manifest.json\" dist/{projectRoot}"
        ]
      }
    }
  }
}