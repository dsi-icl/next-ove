{
  "name": "ove-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-core/src",
  "projectType": "application",
  "implicitDependencies": [
    "ove-renderer"
  ],
  "targets": {
    "db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": [
          "pnpm db sync"
        ]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["tsc -p apps/ove-core/tsconfig.app.json --noEmit --incremental"]
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": [
          "docker build --rm -t next-ove/core:latest --platform linux/amd64 -f apps/ove-core/Dockerfile ."
        ]
      },
      "configurations": {
        "arm": {
          "commands": [
            "docker build --rm -t next-ove/core:latest --platform linux/arm64 -f apps/ove-core/Dockerfile ."
          ]
        }
      },
      "dependsOn": [
        "prebuild",
        {"target": "build", "projects": "ove-renderer", "params": "forward"},
        {"target": "build", "projects": "ove-core-ui", "params": "forward"}
      ]
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/ove-core/src/main.ts",
        "outputPath": "dist/apps/ove-core",
        "outputFileName": "main.cjs",
        "tsConfig": "apps/ove-core/tsconfig.app.json",
        "thirdParty": true,
        "format": [
          "cjs"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ove-core/public",
            "output": "public"
          },
          {
            "glob": "**/*",
            "input": "apps/ove-core/src/assets",
            "output": "assets"
          },
          "apps/ove-core/.env"
        ],
        "generatePackageJson": true,
        "platform": "node"
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true,
          "skipTypeCheck": true
        }
      },
      "dependsOn": [
        "db"
      ]
    },
    "prebuild": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "main": "apps/ove-core/src/main.ts",
        "outputPath": "dist/apps/ove-core",
        "outputFileName": "main.js",
        "tsConfig": "apps/ove-core/tsconfig.app.json",
        "thirdParty": false,
        "format": [
          "cjs"
        ],
        "generatePackageJson": true,
        "minify": true,
        "platform": "node"
      },
      "dependsOn": [
        "db"
      ]
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "ove-core:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "ove-core:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/ove-core/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "dependsOn": [
        "db"
      ],
      "options": {
        "jestConfig": "apps/ove-core/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
