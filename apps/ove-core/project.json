{
  "name": "ove-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-core/src",
  "projectType": "application",
  "targets": {
    "db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["npm run db sync"]
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": [
          "docker build --progress=plain --rm -t next-ove/core:latest --platform linux/amd64 -f apps/ove-core/Dockerfile ."
        ]
      },
      "configurations": {
        "arm": {
          "commands": [
            "docker build --progress=plain --rm -t next-ove/core:latest --platform linux/arm64 -f apps/ove-core/Dockerfile ."
          ]
        }
      },
      "dependsOn": ["build"]
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/ove-core/src/main.ts",
        "outputPath": "dist/apps/ove-core",
        "outputFileName": "main.js",
        "tsConfig": "apps/ove-core/tsconfig.app.json",
        "thirdParty": true,
        "format": ["cjs"],
        "generatePackageJson": true,
        "external": [
          "bcrypt"
        ],
        "platform": "node"
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true,
          "skipTypeCheck": true
        }
      },
      "dependsOn": ["db"]
    },
    "prebuild": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "apps/ove-core/src/main.ts",
        "outputPath": "dist/apps/ove-core",
        "outputFileName": "main.js",
        "tsConfig": "apps/ove-core/tsconfig.app.json",
        "thirdParty": false,
        "format": ["cjs"],
        "generatePackageJson": true,
        "minify": true,
        "external": [
          "bcrypt"
        ],
        "platform": "node"
      },
      "dependsOn": ["db"]
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "ove-core:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "ove-core:build:production"
        }
      },
      "dependsOn": ["db"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ove-core/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "dependsOn": ["db"],
      "options": {
        "jestConfig": "apps/ove-core/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
