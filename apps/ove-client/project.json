{
  "name": "ove-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-client/src",
  "projectType": "application",
  "targets": {
    "db": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/tools/db/schema.prisma"
      ],
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": [
          "pnpm db sync"
        ]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["tsc -p apps/ove-client/tsconfig.app.json --noEmit --incremental"]
      }
    },
    "build": {
      "executor": "nx-electron:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/ove-client",
        "main": "apps/ove-client/src/main.ts",
        "tsConfig": "apps/ove-client/tsconfig.app.json",
        "assets": [
          "apps/ove-client/src/assets"
        ],
        "webpackConfig": "apps/ove-client/webpack.config.cjs"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      },
      "dependsOn": [
        "db"
      ]
    },
    "serve": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "ove-client:build",
        "args": [
          "dist/apps/ove-client/main.cjs"
        ]
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "ove-client",
        "outputPath": "dist/packages/ove-client",
        "prepackageOnly": true
      },
      "configurations": {
        "windows": {
          "platform": ["windows"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.windows.options.json"
        },
        "linux": {
          "platform": ["windows", "linux"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.linux.options.json"
        },
        "mac": {
          "platform": ["windows", "linux", "mac"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.mac.options.json"
        }
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "ove-client",
        "outputPath": "dist/executables/ove-client",
        "publishPolicy": "never"
      },
      "configurations": {
        "windows": {
          "platform": ["windows"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.windows.options.json"
        },
        "linux": {
          "platform": ["windows", "linux"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.linux.options.json"
        },
        "mac": {
          "platform": ["windows", "linux", "mac"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.mac.options.json"
        }
      }
    },
    "release:linux": {
      "executor": "nx-electron:make",
      "options": {
        "name": "ove-client",
        "outputPath": "dist/executables/ove-client",
        "publishPolicy": "always"
      },
      "configurations": {
        "windows": {
          "platform": ["windows"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.windows.options.json"
        },
        "linux": {
          "platform": ["windows", "linux"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.linux.options.json"
        },
        "mac": {
          "platform": ["windows", "linux", "mac"],
          "makerOptionsPath": "apps/ove-client/src/app/options/maker.mac.options.json"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/ove-client/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/out/coverage/tests/apps/{projectName}"
      ],
      "options": {
        "jestConfig": "apps/ove-client/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
