{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ove-data-formatter",
  "sourceRoot": "apps/ove-data-formatter",
  "projectType": "application",
  "targets": {
    "make": {
      "command": "docker build -t next-ove/ove-data-formatter:latest --platform linux/amd64 -f Dockerfile .",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "command": "uv run main.py",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}