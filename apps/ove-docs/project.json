{
  "name": "ove-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-docs/src",
  "projectType": "application",
  "targets": {
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["tsc -p apps/ove-docs/tsconfig.app.json --noEmit --incremental"]
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": [
          "docker build --rm -t next-ove/docs:latest --platform linux/amd64 -f apps/ove-docs/Dockerfile ."
        ]
      },
      "configurations": {
        "arm": {
          "commands": [
            "docker build --rm -t next-ove/docs:latest --platform linux/arm64 -f apps/ove-docs/Dockerfile ."
          ]
        }
      },
      "dependsOn": ["prebuild"]
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/ove-docs/src/main.ts",
        "outputPath": "dist/apps/ove-docs",
        "outputFileName": "main.cjs",
        "tsConfig": "apps/ove-docs/tsconfig.app.json",
        "thirdParty": true,
        "format": [
          "cjs"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ove-docs/public",
            "output": "public"
          },
          {
            "glob": "**/*",
            "input": "apps/ove-docs/assets",
            "output": "assets"
          }
        ],
        "generatePackageJson": true,
        "platform": "node"
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true,
          "skipTypeCheck": true
        }
      }
    },
    "prebuild": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "main": "apps/ove-docs/src/main.ts",
        "outputPath": "dist/apps/ove-docs",
        "outputFileName": "main.js",
        "tsConfig": "apps/ove-docs/tsconfig.app.json",
        "thirdParty": false,
        "format": [
          "cjs"
        ],
        "external": [
          "swagger-ui-express"
        ],
        "generatePackageJson": true,
        "minify": true,
        "platform": "node"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "ove-docs:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "ove-docs:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/ove-docs/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/ove-docs/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
