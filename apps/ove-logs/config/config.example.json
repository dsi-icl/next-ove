{
  "AUTH": {
    "SERVER_URL": "http://localhost:3333/signing-key",
    "COOKIE_ID": "ove-access",
    "JWT_ALGORITHMS": [
      "RS256"
    ]
  },
  "SERVER": {
    "PORT": 8080
  },
  "API": {
    "PAGE_SIZE": 10,
    "RATE_LIMIT": {
      "WINDOW_MS": 60000,
      "LIMIT": 1000,
