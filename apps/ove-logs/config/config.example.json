      "INTERVAL": 900000,
      "MAX_SIZE": 150000000,
      "MAX_RECORDS": 50000,
      "GET_SIZE_COMMAND": "du -h %DB_LOCATION% | numfmt --from=iec"
    },
    "LOCATION": "ove-logs/data/logs.db"
  },
  "SOCKETS": {
    "PATH": "/sockets"
  }
}