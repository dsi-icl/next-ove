{
  "name": "ove-logs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-logs",
  "projectType": "application",
  "targets": {
    "db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["npm run db sync -- --component=logging"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ove-logs/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "apps/ove-logs/src/server.ts",
        "outputPath": "dist/apps/ove-logs",
        "outputFileName": "main.cjs",
        "tsConfig": "apps/ove-logs/tsconfig.json",
        "format": ["cjs"],
        "thirdParty": true,
        "skipTypeCheck": true,
        "platform": "node"
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true
        }
      },
      "dependsOn": ["db"]
    },
    "prebuild": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "apps/ove-logs/src/server.ts",
        "outputPath": "dist/apps/ove-logs",
        "outputFileName": "main.cjs",
        "tsConfig": "apps/ove-logs/tsconfig.json",
        "format": ["cjs"],
        "thirdParty": false,
        "generatePackageJson": true,
        "skipTypeCheck": true,
        "platform": "node",
        "minify": true
      },
      "dependsOn": ["db"]
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "ove-logs:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "ove-logs:build:production"
        }
      }
    },
    "make": {
      "command": "docker build ../../",
      "options": {
        "args": ["--progress=plain", "-t next-ove/logs:latest", "--platform linux/amd64", "-f Dockerfile"],
        "cwd": "apps/ove-logs"
      },
      "dependsOn": ["prebuild"]
    }
  }
}