{
  "extends": [
    "plugin:@nx/react",
    "plugin:tailwindcss/recommended",
    "../../.eslintrc.json",
    "prettier"
  ],
  "ignorePatterns": [
    "!**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ],
        "no-unused-vars": "off"
      }
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "rules": {
        "require-jsdoc": "off",
        "no-invalid-this": "off",
        "spaced-comment": [
          "error",
          "always",
          {
            "line": {
              "markers": [
                "/"
              ]
            }
          }
        ]
      }
    },
    {
      "files": [
        "*.jsx",
        "*.tsx"
      ],
      "rules": {
        "max-len": [
          "error",
          {
            "ignoreStrings": true
          }
        ],
        "tailwindcss/no-custom-classname": [
          "error",
          {
            "whitelist": [
              "from-muted/50",
              "to-muted",
              "bg-primary",
              "text-muted-foreground",
              "bg-accent",
              "text-accent-foreground"
            ]
          }
        ]
      }
    }
  ]
}
