{
  "name": "ove-core-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ove-core-ui/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "db": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/tools/db/schema.prisma",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": [
        "{workspaceRoot}/node_modules/.prisma",
        "{workspaceRoot}/node_modules/@prisma/client"
      ],
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["pnpm db sync"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/",
        "commands": ["tsc -p apps/ove-core-ui/tsconfig.app.json --noEmit --incremental"]
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "emptyOutDir": true,
        "generatePackageJson": true,
        "buildLibsFromSource": true,
        "outputPath": "dist/apps/ove-core-ui"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production",
          "skipTypeCheck": true
        }
      },
      "dependsOn": ["db"]
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "ove-core-ui:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "ove-core-ui:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "ove-core-ui:build:production",
          "hmr": false
        },
        "linting": {
          "buildTarget": "ove-core-ui:build:linting",
          "hmr": true
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "ove-core-ui:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "ove-core-ui:build:development"
        },
        "production": {
          "buildTarget": "ove-core-ui:build:production"
        },
        "linting": {
          "buildTarget": "ove-core-ui:build:linting"
        }
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/apps/ove-core-ui"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/ove-core-ui"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ove-core-ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ove-core-ui:build"
      }
    }
  }
}
